# =============================================================================
# MySQL 8.4 Configuration - Optimized for 8GB RAM development host
# Container allocation: ~512MB-1GB for MySQL
# =============================================================================

[mysqld]
# ---------------------------------------------------------------------------
# Character Set & Collation (Laravel default)
# ---------------------------------------------------------------------------
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# ---------------------------------------------------------------------------
# InnoDB - Primary storage engine tuning
# Rule of thumb: innodb_buffer_pool_size = 50-70% of MySQL RAM allocation
# For 512MB container: 256MB buffer pool
# ---------------------------------------------------------------------------
innodb_buffer_pool_size = 256M
innodb_buffer_pool_instances = 1
innodb_log_file_size = 64M
innodb_flush_log_at_trx_commit = 2      # 0=fastest, 1=safest, 2=balanced
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1

# ---------------------------------------------------------------------------
# Connection & Query
# ---------------------------------------------------------------------------
max_connections = 100
wait_timeout = 28800
interactive_timeout = 28800
max_allowed_packet = 64M

# ---------------------------------------------------------------------------
# Query Cache (removed in MySQL 8.x — these are for slow query log)
# ---------------------------------------------------------------------------
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2

# ---------------------------------------------------------------------------
# Performance Schema: Disabled to reduce RAM usage in dev
# Enable in production for monitoring
# ---------------------------------------------------------------------------
performance_schema = OFF

# ---------------------------------------------------------------------------
# Binary Logging: Disabled for dev (enables faster writes)
# Enable in production for replication/point-in-time recovery
# ---------------------------------------------------------------------------
skip-log-bin

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
