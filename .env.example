# =============================================================================
# Docker Environment Variables
# Copy this to .env and fill in your values
# DO NOT commit .env to version control
# =============================================================================

# ---------------------------------------------------------------------------
# Laravel Application
# ---------------------------------------------------------------------------
APP_NAME="Laravel App"
APP_ENV=local
APP_KEY=                        # Generate with: docker exec laravel-php php artisan key:generate --show
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=null                 # Leave empty for no password in dev
REDIS_HOST=laravel-redis
# ---------------------------------------------------------------------------
# Cache / Session / Queue
# ---------------------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ---------------------------------------------------------------------------
# Mail (use Mailpit for local dev — see below for adding Mailpit service)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# PHP Behavior
# ---------------------------------------------------------------------------
PHP_DISPLAY_ERRORS=1                    # Set to 0 in production
OPCACHE_VALIDATE_TIMESTAMPS=1           # Set to 0 in production

# ---------------------------------------------------------------------------
# Docker Port Mapping (host:container)
# Change host ports if they conflict with other services
# ---------------------------------------------------------------------------
DOCKER_HTTP_PORT=8080
DOCKER_MYSQL_PORT=3306
DOCKER_REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Docker Build
# Match your host user's UID/GID to avoid permission issues
# Run: id -u && id -g to find your values
# ---------------------------------------------------------------------------
DOCKER_UID=1000
DOCKER_GID=1000
